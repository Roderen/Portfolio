# Database Configuration
# PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?sslmode=require"

# Direct database connection URL (used for migrations, bypasses connection pooling)
# Required when using PgBouncer or similar connection poolers
# Can be the same as DATABASE_URL if not using a pooler
DIRECT_URL="postgresql://user:password@localhost:5432/portfolio?sslmode=require"

# Authentication
# Secret key for JWT token signing (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Admin User Credentials
# Email address for the admin user
ADMIN_EMAIL="admin@example.com"
# Password for the admin user (will be hashed with bcrypt)
ADMIN_PASSWORD="your-secure-password-here"

# One-time Setup
# Secret token required for initial setup endpoint (/api/setup)
# Only needed during initial deployment, can be removed after setup
SETUP_SECRET="your-one-time-setup-secret"

# Telegram Notifications (Optional)
# Bot token from @BotFather on Telegram
# Get yours at: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=""
# Your Telegram chat ID where notifications will be sent
# Find yours with: https://t.me/userinfobot
TELEGRAM_CHAT_ID=""

# Vercel Configuration (Production)
# These are automatically set by Vercel, no need to configure manually:
# - BLOB_READ_WRITE_TOKEN (for Vercel Blob storage)
# - POSTGRES_* (if using Vercel Postgres)

# Development Notes:
# - Copy this file to .env.local for local development
# - Never commit .env.local to version control
# - For production, set these variables in your hosting platform (Vercel, etc.)
